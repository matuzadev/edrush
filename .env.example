# Authentication
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local development uses SQLite. Set a remote libsql:// URL for production.
TURSO_DB_URL=file:data/foco-federal.db
TURSO_AUTH_TOKEN=

# Question token signing
QUESTION_SECRET=replace-with-a-random-32-byte-hex-secret

# Optional application settings
ADMIN_EMAILS=
FOUNDER_EMAIL=
