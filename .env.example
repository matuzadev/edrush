# Authentication
NEXTAUTH_URL=https://edrush.vercel.app
NEXTAUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Persistent database (Turso/libSQL; local SQLite files are not persistent on Vercel)
TURSO_DB_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=

# Question token signing
QUESTION_SECRET=replace-with-a-random-32-byte-hex-secret

# Optional application settings
ADMIN_EMAILS=
